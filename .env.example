MINIO_EVENT_EXCHANGE=minio.events # Optional
MINIO_EVENT_QUEUE=image-uploads # Optional

RABBITMQ_USER="" # Used for docker compose
RABBITMQ_PASS="" # Used for docker compose
RABBITMQ_URL="amqp://<username>:<password>@localhost:5672"

MINIO_ACCESS_KEY=
